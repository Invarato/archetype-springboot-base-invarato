<archetype-descriptor
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
        name="arquetipo">

    <!--
      ⚠️ ESTE FICHERO DECIDE QUE LLEGA AL PROYECTO GENERADO.
      Un fichero puede existir en archetype-resources/ y NO generarse nunca si no esta declarado aqui. Ya nos
      costo dos veces: k8s/ con los fileSet comentados (y skaffold.yaml generandose apuntando a manifiestos
      inexistentes) y `liquibase.sh` declarado con otra extension que la del fichero real.

      REGLA: si tocas la plantilla, comprueba en el proyecto generado que tu fichero esta ahi.

      `filtered="true"`  -> se sustituyen ${groupId} / ${artifactId} (pasa por Velocity).
      `packaged="true"`  -> el contenido cuelga del paquete (com/ejemplo/...).
    -->

    <requiredProperties>
        <requiredProperty key="groupId">
            <defaultValue>${groupId}</defaultValue>
        </requiredProperty>

        <requiredProperty key="artifactId">
            <defaultValue>${artifactId}</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <fileSets>

        <!-- ═══ Modulo app: el microservicio ═══════════════════════════════════════════════ -->

        <fileSet filtered="true" packaged="true">
            <directory>app/src/main/java</directory>
        </fileSet>

        <fileSet filtered="true" packaged="true">
            <directory>app/src/test/java</directory>
        </fileSet>

        <!-- Recursos que NO se filtran (binarios como el favicon, y los .gitkeep de db/migration) -->
        <fileSet encoding="UTF-8" filtered="false" preserve-empty-dirs="true">
            <directory>app/src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>**/*.properties</exclude>
                <exclude>**/.gitkeep</exclude>
                <exclude>**/*.yaml</exclude>
                <exclude>**/*.yml</exclude>
            </excludes>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true">
            <directory>app/src/main/resources</directory>
            <includes>
                <include>**/*.properties</include>
                <include>**/*.yaml</include>
                <include>**/*.yml</include>
            </includes>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true">
            <directory>app/src/test/resources</directory>
            <includes>
                <include>**/*.properties</include>
                <include>**/*.yaml</include>
                <include>**/*.yml</include>
            </includes>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true">
            <directory>app</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <!-- ═══ Modulo contract: el OpenAPI y, mas adelante, los clientes generados ═════════ -->

        <fileSet encoding="UTF-8" filtered="true">
            <directory>contract</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true" preserve-empty-dirs="true">
            <directory>contract/src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!-- ═══ Clientes generados desde el contrato ═════════════════════════════════════ -->

        <fileSet encoding="UTF-8" filtered="true">
            <directory>client-java</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <!-- El ejemplo de uso y su test. En src/test para que NO viajen dentro del jar publicado. -->
        <fileSet filtered="true" packaged="true">
            <directory>client-java/src/test/java</directory>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true">
            <directory>client-python</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <!--
          ⚠️ SIN filtrar, y no es por comodidad: en Python los comentarios empiezan por `#`, que es
          justo el caracter de las directivas de Velocity. Un `##` se lo comeria entero como comentario
          suyo (es el fallo G17, que ya nos costo 54 lineas de un markdown). Como el ejemplo no lleva
          ningun placeholder del arquetipo, lo mas seguro es que Velocity ni lo mire.
        -->
        <fileSet encoding="UTF-8" filtered="false">
            <directory>client-python</directory>
            <includes>
                <include>**/*.py</include>
            </includes>
        </fileSet>

        <!-- ═══ Raiz del proyecto ══════════════════════════════════════════════════════════ -->

        <!-- Sin filtrar: no llevan placeholders, y algunos (mvnw) romperian al pasar por Velocity -->
        <fileSet encoding="UTF-8" filtered="false">
            <directory></directory>
            <includes>
                <include>compose.yml</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
                <include>.gitignore</include>
                <include>.dockerignore</include>
            </includes>
        </fileSet>

        <fileSet encoding="UTF-8" filtered="true">
            <directory></directory>
            <includes>
                <include>compose-app.yml</include>
                <include>readme.md</include>
                <include>Makefile</include>
                <include>Dockerfile</include>
                <include>MAKEFILE.md</include>
            </includes>
        </fileSet>

        <!--
          .mvn/ : el maven.config (defecto de ${revision}, imprescindible para `mvn -pl`) y las properties
          del wrapper. Sin esto, `mvnw` se copiaba SIN su configuracion y no funcionaba.
        -->
        <fileSet encoding="UTF-8" filtered="false">
            <directory>.mvn</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!--
          La CI del proyecto generado. Va FILTRADA porque lleva ${artifactId}, y declarada aqui porque
          si no, no viaja (G6).
        -->
        <fileSet encoding="UTF-8" filtered="true">
            <directory>.github</directory>
            <includes>
                <include>**/*.yml</include>
            </includes>
        </fileSet>

        <fileSet filtered="false" packaged="false">
            <directory>docker</directory>
        </fileSet>

        <fileSet filtered="false" packaged="false">
            <directory>.devcontainer</directory>
        </fileSet>

        <!-- ═══ Kubernetes (chart de Helm) ═══════════════════════════════════════════════
             ⚠️ El directorio se llama `__artifactId__` y se renombra al generar: el arquetipo
             sustituye los `__propiedad__` tambien en los NOMBRES de fichero y de carpeta, no solo
             dentro del contenido.
        -->
        <fileSet encoding="UTF-8" filtered="true">
            <directory>helm</directory>
            <includes>
                <include>**/*.yaml</include>
                <include>**/*.tpl</include>
                <include>**/*.md</include>
            </includes>
        </fileSet>

    </fileSets>

</archetype-descriptor>
