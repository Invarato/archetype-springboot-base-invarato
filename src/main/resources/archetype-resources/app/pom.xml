<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      EL MICROSERVICIO. Es el unico modulo que produce un jar ejecutable y una imagen Docker.
      Las versiones y los plugins comunes estan en el pom padre.
    -->
    <parent>
        <groupId>${groupId}</groupId>
        <artifactId>${artifactId}</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>${artifactId}-app</artifactId>
    <name>${artifactId}-app</name>

    <dependencies>

        <!--   Observabilidad   -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Trazas distribuidas (OpenTelemetry).

          Este starter es de Spring Boot 4 y sustituye al montaje manual que hacia falta antes
          (micrometer-tracing + puente de OTel + exportador, cada uno por su lado). Trae la
          instrumentacion, el contexto de propagacion y el exportador OTLP.

          Que aporta sobre la correlacion que ya habia: el traceId en el log te deja seguir una peticion
          DENTRO de este servicio; esto te deja seguirla ENTRE servicios, que es donde se pierde el tiempo
          cuando algo va lento y nadie sabe en que salto.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!--
          Expone /actuator/prometheus para que lo raspe Prometheus. Sin version: la gestiona el BOM de
          Spring Boot importando el de Micrometer.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          Los logs en JSON NO llevan dependencia: el logging estructurado viene en Spring Boot desde la
          3.4 (ver `logging.structured` en application.yaml). Antes habia aqui un
          net.logstash.logback:logstash-logback-encoder Y un logback-spring.xml de 74 lineas: ya no
          hace falta ninguno de los dos.
        -->
        <!--   Observabilidad   -->

        <!--  DB  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Cache + Redis. Hacen falta LOS DOS, y es un error facil de cometer dos veces:

            - spring-boot-starter-cache trae la ABSTRACCION (@Cacheable, @CacheEvict) y quien lee las
              propiedades `spring.cache.*`.
            - spring-boot-starter-data-redis trae la IMPLEMENTACION que las respalda.

          Sin el de cache, el bloque `spring.cache.redis.*` del yaml no lo lee nadie y las anotaciones
          no hacen nada; sin el de redis, `spring.cache.type=redis` no tiene con que funcionar. En los
          dos casos la aplicacion ARRANCA TAN CONTENTA y simplemente no cachea, que es justo lo que
          habia aqui: configuracion detallada apuntando a algo que no existia.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-envers</artifactId>
        </dependency>
        <!--  DB  -->

        <!--   Controller   -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--   Controller   -->

        <!--
          Seguridad. Va SIEMPRE activa: no hay perfil que la apague (ver configs/SecurityConfig).

          `oauth2-resource-server` en vez de un filtro JWT escrito a mano: la validacion de firma,
          emisor, audiencia y expiracion ya esta hecha y probada. Un filtro propio es codigo de
          seguridad sin revisar, que es la peor clase de codigo propio.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          ArchUnit: tests que comprueban la ESTRUCTURA, no el comportamiento (ver ArchitectureTest).
          Una estructura que solo esta documentada se erosiona; esta se rompe en el build.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Tests -->

        <!--    Anticode boilerplate    -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--    Anticode boilerplate    -->

        <!--    Documentation    -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>
        <!--
          Documentacion de la API desde el JAVADOC, en vez de repetirla en anotaciones @Operation.

          Mantener una documentacion ya cuesta; mantener DOS que dicen lo mismo es como se desincronizan.
          Con esto, el javadoc de un metodo pasa a ser la descripcion de la operacion en el contrato, y el
          de un campo la de su propiedad. Una sola fuente.

          ⚠️ Solo cubre DESCRIPCIONES. Para summary, ejemplos, codigos de respuesta o esquemas
          polimorficos siguen haciendo falta las anotaciones de Swagger.
        -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>${therapi.version}</version>
        </dependency>
        <!--    Documentation    -->

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- MapStruct -->

        <!--
          Migraciones: Flyway (ver docs/base-del-proyecto.md D2).

          ⚠️ HACEN FALTA LAS DOS, y las dos trampas son silenciosas:
            - `flyway-core` a secas NO migra nada y NO avisa. Boot 4 partio las autoconfiguraciones en
              starters, asi que lo que hace el trabajo es `spring-boot-starter-flyway`.
            - Flyway movio el soporte de cada motor a su propio modulo: sin `flyway-database-postgresql`
              falla al arrancar.
          Las versiones las gestiona el BOM de Spring Boot: no las fijes a mano.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

    </dependencies>


    <build>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                      La aplicacion se arranca desde la RAIZ del reactor, no desde app/.
                      `mvn -pl app spring-boot:run` correria dentro de app/, y entonces cualquier ruta
                      relativa de la configuracion apunta al sitio equivocado: `compose.yaml` esta en
                      la raiz y el soporte de Docker Compose no lo encontraba. El sintoma era la
                      aplicacion quejandose de que no hay DataSource, que no lleva a este fichero.
                    -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests (*Test.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                    <!--
                      ⚠️ DevTools FUERA del classpath de los tests. No vale con desactivarlo por
                      configuracion: la propia documentacion de Spring Boot avisa de que poner
                      `spring.devtools.restart.enabled=false` en el yaml **sigue inicializando el
                      classloader de reinicio**, y ese es justo el problema.

                      Lo que pasaba: DevTools carga las clases de la aplicacion en un classloader
                      aparte, y con dos classloaders en juego los tests de invalidacion de cache de
                      CacheIT fallaban — el valor viejo seguia despues de un @CacheEvict. Se vio al
                      arreglar la activacion del perfil `dev`: hasta entonces devtools ni llegaba al
                      classpath, asi que el problema estaba latente.

                      Excluirlo aqui deja el recargado en caliente donde sirve (`spring-boot:run`, el
                      IDE) y lo quita de donde estorba.
                    -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.springframework.boot:spring-boot-devtools</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>

            <!-- Integration tests (*IT.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <!-- Mismo motivo que en surefire: ver el comentario de arriba. -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.springframework.boot:spring-boot-devtools</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <!--
                          ⚠️ Este binding NO es opcional teniendo Lombok y MapStruct a la vez.
                          Los dos son procesadores de anotaciones y el orden en que se ejecutan no esta
                          garantizado: si MapStruct mira la entidad ANTES de que Lombok le haya generado
                          los getters, no los ve y falla con "Unmapped target property" o genera mapeos
                          vacios. El binding coordina las dos pasadas.
                          Va el ULTIMO a proposito: tiene que ver a los dos anteriores.
                        -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <!--
                          Embebe el javadoc en el bytecode para que springdoc pueda leerlo en tiempo de
                          ejecucion. Es lo que permite documentar la API con javadoc en vez de repetirlo
                          en anotaciones.
                          ⚠️ Tiene que estar en TODOS los modulos cuyas clases quieras documentar. Si un
                          DTO vive en otro modulo sin este procesador, sus campos salen sin descripcion.
                        -->
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <!--
              ⚠️ NO uses `activeByDefault` aqui, aunque sea lo que pide el cuerpo. Maven lo APAGA en
              cuanto se activa cualquier otro perfil de este mismo pom — y justo debajo hay uno,
              `devcontainer`, que se activa solo con que exista /.dockerenv.

              Efecto real mientras estuvo asi: dentro del devcontainer (el entorno que recomienda este
              proyecto) el perfil `dev` no se activaba nunca, asi que **devtools y el soporte de Docker
              Compose no estaban en el classpath**. Nada fallaba: simplemente no habia recarga en
              caliente y los contenedores no se levantaban solos, y no habia forma de sospechar por que.

              La activacion por propiedad negada no tiene ese problema: se evalua por su cuenta. Para
              construir sin estas herramientas: `mvn -DsinHerramientasDeDesarrollo ...`
            -->
            <activation>
                <property>
                    <name>!sinHerramientasDeDesarrollo</name>
                </property>
            </activation>

            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-devtools</artifactId>
                    <scope>runtime</scope>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-docker-compose</artifactId>
                    <scope>runtime</scope>
                    <optional>true</optional>
                </dependency>
            </dependencies>

        </profile>

        <profile>
            <id>test</id>
            <properties>
                <spring.profiles.active>test</spring.profiles.active>
            </properties>
        </profile>

        <!--
          Testcontainers dentro de un devcontainer.

          ⚠️ Gotcha caro: desde dentro de un contenedor, Testcontainers da por hecho que alcanza los puertos
          publicados en 172.17.0.1, que no responde -> TODOS los *IT mueren con "Could not connect to Ryuk"
          y el error no apunta por ningun lado a la red.

          Se activa por la existencia de /.dockerenv, o sea SOLO dentro de un contenedor. En CI (que corre
          sobre la VM) no se activa, porque alli el comportamiento por defecto ya es el correcto.
        -->
        <profile>
            <id>devcontainer</id>
            <activation>
                <file>
                    <exists>/.dockerenv</exists>
                </file>
            </activation>
            <properties>
                <testcontainers.host.override>localhost</testcontainers.host.override>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <environmentVariables>
                                <TESTCONTAINERS_HOST_OVERRIDE>localhost</TESTCONTAINERS_HOST_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <environmentVariables>
                                <TESTCONTAINERS_HOST_OVERRIDE>localhost</TESTCONTAINERS_HOST_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
