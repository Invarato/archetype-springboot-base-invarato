// For more customization options, see https://containers.dev/implementors/json_reference
{
  name: "Spring Boot & Postgres Dev Environment",
  dockerComposeFile: "compose.yml",
  service: "app", // El servicio donde trabajarás
  workspaceFolder: "/workspace/${localWorkspaceFolderBasename}",
  //  "workspaceFolder": "/workspace",

  forwardPorts: [
    8080,
    5432,
    6379
  ],


  customizations: {
    "jetbrains": {
      "backend": "IntelliJ",
      settings : {
        "Git4Idea:app:Git-Application-Settings.use_credential_helper": true
      },
      "plugins": [
        "com.intellij.database" // Plugin para ver la DB desde el IDE
      ]
    }
  },

  // https://containers.dev/features
  features: {
    "ghcr.io/devcontainers/features/git": {
      "version": "latest",
      //      "ppa": false
    },
    "ghcr.io/devcontainers/features/java": {
      "version": "25",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker": {
      "version": "latest",
      "moby": false,
      //      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/common-utils": {
      //      "installZsh": "false",
      //      "configureZshAsDefaultShell": "false",
      "username": "vscode",
      //      "upgradePackages": "true"
    },
    "ghcr.io/jungaretti/features/make:1": {},
    "ghcr.io/devcontainers/features/azure-cli": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube": {
      "kubectl": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },

  containerEnv: {
    "DOCKER_BUILDKIT": "1"
    //    "TESTCONTAINERS_RYUK_DISABLED": "false"
  },

    "postCreateCommand": "java -version && mvn -version && docker version && az version && terraform version && kubectl version --client",

  remoteUser: "vscode"
}