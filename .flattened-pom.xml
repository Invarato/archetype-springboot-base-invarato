<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jarroba</groupId>
    <artifactId>archetype-springboot-base-invarato</artifactId>
    <!--
      La version NO se escribe aqui: la pone el build (`-Drevision=X.Y.Z`), y en un release la pone el
      TAG de git. Asi no hay commits de "subir version", ni ramas que se olvidan de bajarla, ni el
      riesgo clasico de publicar con la version anterior porque nadie la toco.
      Es el mismo mecanismo que el arquetipo enseña a sus proyectos (ver D3).
    -->
    <version>2.0.0-SNAPSHOT</version>
    <packaging>maven-archetype</packaging>

    <properties>
        <!-- Defecto para builds locales. .mvn/maven.config repite el valor a proposito: Maven necesita
             resolver la version antes de leer estas propiedades. -->
        <revision>2.0.0-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    </properties>


    <name>Archetype SpringBoot Base Invarato</name>
    <description>Base archetype for SpringBoot projects with standard configurations</description>
    <url>https://github.com/Invarato/archetype-springboot-base-invarato</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ramon Invarato</name>
            <email>r.invarato@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Invarato/archetype-springboot-base-invarato.git</connection>
        <developerConnection>scm:git:https://github.com/Invarato/archetype-springboot-base-invarato.git</developerConnection>
        <url>https://github.com/Invarato/archetype-springboot-base-invarato</url>
        <tag>HEAD</tag>
    </scm>



    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.4.1</version>
            </extension>
        </extensions>

        <plugins>
            <!--
              flatten: obligatorio al usar 2.0.0-SNAPSHOT. Sin el, el pom que se PUBLICA en Maven Central
              conservaria el literal `2.0.0-SNAPSHOT` y `archetype:generate` no podria resolverlo — o sea,
              el arquetipo se publicaria roto y no habria forma de arreglarlo sin sacar otra version
              (Central no permite reemplazar una publicada).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                     <!-- Required so that .gitignore gets included in archetypes -->
                    <useDefaultExcludes>false</useDefaultExcludes>
<!--                    <archetypeVersion>${project.version}</archetypeVersion>-->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
<!--                <version>3.3.0</version>-->
                <version>3.5.1</version>
                <configuration>
                    <classifier>archetype</classifier>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <configuration>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>